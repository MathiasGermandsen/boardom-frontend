@page "/power"
@using Boardom.Services
@using Boardom.Models
@inject PowerService PowerService

<PageTitle>Power Settings - BOARDOM</PageTitle>

<div class="power-container">
  <div class="power-header">
    <div>
      <h1 class="power-title">Power Settings</h1>
      <p class="power-subtitle">Configure energy pricing and provider preferences</p>
    </div>
  </div>

  <div class="power-content">
    <div class="settings-form">
      <!-- Selection Mode Section -->
      <div class="form-section">
        <label for="selectionMode" class="form-label">Selection Mode</label>
        <p class="form-hint">Choose how to manage your power settings</p>
        
        <select
          id="selectionMode"
          class="company-dropdown"
          @bind="selectionMode"
        >
          <option value="">-- Choose a mode --</option>
          <option value="price-based">Price Based</option>
          <option value="hour-based">Hour Based</option>
        </select>
      </div>

      <!-- Max Price Per kWh Section (Price Based) -->
      @if (selectionMode == "price-based")
      {
        <div class="form-section">
          <label for="maxPrice" class="form-label">Max Price Per kWh (DKK)</label>
          <div class="input-wrapper">
            <input
              type="number"
              id="maxPrice"
              class="price-input"
              placeholder="Enter max price"
              step="0.01"
              min="0"
              @bind="maxPricePerKwh"
            />
            <span class="input-suffix">DKK</span>
          </div>
          <p class="form-hint">Set the maximum price you're willing to pay per kilowatt-hour</p>
        </div>
      }

      <!-- Number of Hours Section (Hour Based) -->
      @if (selectionMode == "hour-based")
      {
        <div class="form-section">
          <label for="numberOfHours" class="form-label">Number of Hours</label>
          <div class="input-wrapper">
            <input
              type="number"
              id="numberOfHours"
              class="price-input"
              placeholder="Enter number of hours"
              step="1"
              min="0"
              @bind="numberOfHours"
            />
            <span class="input-suffix">hours</span>
          </div>
          <p class="form-hint">Set the number of hours for power management</p>
        </div>
      }

      <!-- Energy Company Selection Section -->
      <div class="form-section">
        <label for="energyCompany" class="form-label">Energy Company</label>
        <p class="form-hint">Select your preferred energy company</p>
        
        <select
          id="energyCompany"
          class="company-dropdown"
          @bind="selectedCompany"
        >
          <option value="">-- Choose a company --</option>
          @foreach (string company in energyCompanies)
          {
            <option value="@company">@company</option>
          }
        </select>
      </div>

      <!-- Action Buttons -->
      <div class="form-actions">
        <button class="btn-primary @GetButtonClass()" @onclick="SaveSettings" disabled="@isSaving">
          <span class="button-content">
            @if (saveStatus == "success")
            {
              <span class="feedback-icon">✓</span>
              <span>Saved!</span>
            }
            else if (saveStatus == "error")
            {
              <span class="feedback-icon error">✕</span>
              <span>Failed to Save</span>
            }
            else
            {
              <span>Save Settings</span>
            }
          </span>
        </button>
      </div>
    </div>
  </div>
</div>

@code {
  private string selectionMode = "";
  private double maxPricePerKwh;
  private int numberOfHours;
  private string selectedCompany;
  private List<string> energyCompanies = new();
  private string saveStatus = "";
  private bool isSaving = false;

  protected override async Task OnInitializedAsync()
  {
    if (PowerService.AllCompanies.Count() == 0)
    {
      energyCompanies = await PowerService.GetCompaniesAsync();
    }
    else
    {
      energyCompanies = PowerService.AllCompanies;
    }

    PowerObject powObj = await PowerService.GetSavedSettingsAsync();

    if (powObj == null)
    {
      return; // no error handling lol
    }

    selectionMode = powObj.Selection;
    selectedCompany = powObj.Company;
    numberOfHours = powObj.Hours;
    maxPricePerKwh = powObj.MaxPrice;

    PowerService.SelectionMode = selectionMode;
    PowerService.SelectedCompany = selectedCompany;
    PowerService.Hours = numberOfHours;
    PowerService.SelectedMaxPrice = maxPricePerKwh;
  }

  private async Task SaveSettings()
  {
    isSaving = true;

    PowerObject powObj = new PowerObject()
    {
      Selection = selectionMode,
      Company = selectedCompany,
      Hours = numberOfHours,
      MaxPrice = maxPricePerKwh
    };

    bool success = await PowerService.SaveSelectionAsync(powObj);
    
    saveStatus = success ? "success" : "error";
    StateHasChanged();
    
    await Task.Delay(2500);
    saveStatus = "";
    isSaving = false;
    StateHasChanged();
  }

  private string GetButtonClass()
  {
    return saveStatus == "success" ? "btn-success" : saveStatus == "error" ? "btn-error" : "";
  }
}
