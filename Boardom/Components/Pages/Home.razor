@page "/home"
@using Microsoft.AspNetCore.Components.Authorization;
@using Microsoft.AspNetCore.Authorization;
@using Boardom.Models
@using Boardom.Services
@using Microsoft.IdentityModel.Abstractions
@using System.Runtime.CompilerServices
@implements IDisposable
@inject PendingDeviceStore PendingDeviceStore
@inject NavigationManager NavigationManager
@inject DeviceFunctions DeviceFunctions
@inject DeviceStatus DeviceStatus

@attribute [Authorize]

<PageTitle>BOARDOM - Household Monitoring System</PageTitle>

@if (isLoading)
{
  <div style="text-align:center;padding:5rem;color:#e8eef7;">Loading dashboard data…</div>
}
else
{
  <div class="dashboard-container">
    <div class="dashboard-header">
      <h1 class="dashboard-title">System Overview</h1>
      <p class="dashboard-subtitle">Real-time monitoring of household sensor devices</p>
      <div class="dashboard-stats">
        <div class="stat-card">
          <div class="stat-icon">●</div>
          <span class="stat-label">ACTIVE DEVICES IN GROUPS</span>
          <span class="stat-value">@activeDeviceCount</span>
        </div>
        <div class="stat-card">
          <div class="stat-icon">●</div>
          <span class="stat-label">DEVICE GROUPS</span>
          <span class="stat-value">@groups.Count</span>
        </div>
        <div class="stat-card">
          <div class="stat-icon">●</div>
          <span class="stat-label">AVERAGE TEMPERATURE</span>
          <span class="stat-value">@FormatTemp(averageTemperature)</span>
        </div>
      </div>
    </div>
    <div class="dashboard-groups">
      @foreach (DeviceGroup group in groups)
      {
        <div class="dashboard-group">
          <div class="group-header">
            <h2>@group.Name</h2>
            <span class="device-count">@group.Devices.Count device@(group.Devices.Count != 1 ? "s" : "")</span>
          </div>
          <div class="arduino-list">
            @foreach (Device device in group.Devices)
            {
              <div class="arduino-card">
                <div class="card-header">
                  <h3>@device.Name</h3>
                  @if (DeviceStatus.StatusList[device.DeviceId])
                  {
                    <span class="device-status online">● Online</span>
                  }
                  else
                  {
                    <span class="device-status offline">● Offline</span>
                  }
                </div>
                <div class="sensor-data">
                  @{
                    var disabled = !DeviceStatus.StatusList[device.DeviceId] || device.LatestReading is null;
                  }
                  @foreach (var sensor in SensorDefinitions)
                  {
                    <div class="sensor-item @(disabled ? "disabled" : "")">
                      <div class="sensor-info">
                        <span class="sensor-icon">@sensor.Icon</span>
                        <span class="sensor-label">@sensor.Label</span>
                      </div>
                      <span class="sensor-value">@sensor.Format(device.LatestReading)</span>
                    </div>
                  }
                </div>
              </div>
            }
          </div>
        </div>
      }
    </div>
  </div>
}

<button type="button" class="fab-add-device" @onclick="OpenAddDevice" aria-label="Add device">+</button>
<button type="button" class="fab-manage-devices" @onclick="OpenManageDevices" aria-label="Manage devices">⚙</button>
<button type="button" class="fab-manage-groups" @onclick="OpenManageGroups" aria-label="Manage groups">⊞</button>

@if (showAddDevice)
{
  <div class="add-device-overlay">
    <div class="add-device-modal" @onclick:stopPropagation="true">
      <h1 class="add-device-title">ADD DEVICE</h1>

      @if (string.IsNullOrWhiteSpace(pendingDeviceId))
      {
        <p class="add-device-waiting">Waiting for device...</p>

        <div class="add-device-actions">
          <button class="btn btn-secondary" @onclick="CancelAddDevice">Cancel</button>
        </div>
      }
      else
      {
        <p class="add-device-found">
          Device connected: <span class="device-id">@pendingDeviceId</span>
        </p>

        <div class="add-device-form">
          <label>Friendly name</label>
          <input class="form-control" @bind="friendlyName" @bind:event="oninput" />
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
          <div class="add-device-error">@errorMessage</div>
        }

        <div class="add-device-actions">
          <button class="btn btn-secondary" @onclick="CancelAddDevice" disabled="@isSubmitting">Cancel</button>
          <button class="btn btn-primary" @onclick="SubmitAddDevice" disabled="@(!CanSubmit)">Add</button>
        </div>
      }
    </div>
  </div>
}

@if (showManageDevices)
{
  <div class="add-device-overlay">
    <div class="add-device-modal" @onclick:stopPropagation="true">
      <h1 class="add-device-title">MANAGE DEVICES</h1>

      @if (isLoadingDevices)
      {
        <p class="add-device-waiting">Loading devices...</p>
      }
      else if (devices == null || !devices.Any())
      {
        <p class="add-device-waiting">No devices found.</p>
      }
      else
      {
        <div class="manage-device-list">
          @foreach (var device in devices)
          {
            <div class="manage-device-item">
              @if (editingDeviceId == device.DeviceId)
              {
                <div class="manage-device-edit">
                  <input class="form-control" @bind="editFriendlyName" @bind:event="oninput" />
                  <div class="manage-device-actions">
                    <button class="btn btn-primary" @onclick="() => SubmitEditDevice(device.DeviceId)"
                            disabled="@(isSubmitting || string.IsNullOrWhiteSpace(editFriendlyName))">Save</button>
                    <button class="btn btn-secondary" @onclick="CancelEdit" disabled="@isSubmitting">Cancel</button>
                  </div>
                </div>
              }
              else
              {
                <div class="manage-device-info">
                  <span class="device-friendly-name">@device.FriendlyName</span>
                  <span class="device-id-small">@device.DeviceId</span>
                  <span class="device-state @(!device.IsActive ? "online" : "offline")">
                    ● @(!device.IsActive ? "Active" : "Inactive")
                  </span>
                </div>
                <div class="manage-device-actions">
                  <button class="btn btn-secondary" @onclick="() => StartEditDevice(device)"
                          disabled="@isSubmitting">Edit</button>
                  <button class="btn btn-danger" @onclick="() => ToggleDeviceActive(device)" disabled="@isSubmitting">
                    Delete
                  </button>
                </div>
              }
            </div>
          }
        </div>
      }

      @if (!string.IsNullOrWhiteSpace(manageErrorMessage))
      {
        <div class="add-device-error">@manageErrorMessage</div>
      }

      <div class="add-device-actions">
        <button class="btn btn-secondary" @onclick="CloseManageDevices">Close</button>
      </div>
    </div>
  </div>
}

@if (showManageGroups)
{
  <div class="add-device-overlay">
    <div class="add-device-modal" @onclick:stopPropagation="true">
      <h1 class="add-device-title">MANAGE GROUPS</h1>

      @if (isLoadingGroups)
      {
        <p class="add-device-waiting">Loading groups...</p>
      }
      else
      {
        <div class="manage-device-list">
          @foreach (DeviceGroup group in managedGroups)
          {
            <div class="manage-device-item">
              @if (editingGroupName == group.Name)
              {
                <div class="manage-device-edit">
                  <input class="form-control" @bind="editGroupNameValue" @bind:event="oninput" />
                  <div class="manage-device-actions">
                    <button class="btn btn-primary"
                            @onclick="() => SubmitEditGroup(group.Name)"
                            disabled="@(isSubmittingGroup || string.IsNullOrWhiteSpace(editGroupNameValue))">Save</button>
                    <button class="btn btn-secondary" @onclick="CancelEditGroup" disabled="@isSubmittingGroup">Cancel</button>
                  </div>
                </div>
              }
              else
              {
                <div class="manage-device-info">
                  <span class="device-friendly-name">@group.Name</span>
                  <span class="device-id-small">@group.Devices.Count device(s)</span>
                </div>
                <div class="manage-device-actions">
                  <button class="btn btn-secondary" @onclick="() => StartEditGroup(group.Name)" disabled="@isSubmittingGroup">Edit</button>
                  <button class="btn btn-danger" @onclick="() => DeleteGroup(group.Name)" disabled="@isSubmittingGroup">Delete</button>
                </div>
                  <select class="form-control" @bind="selectedDeviceId">
                    <option value="">-- Select device --</option>
                      @if (devices != null)
                      {
                        @foreach (var d in devices)
                          {
                              <option value="@d.DeviceId">@d.FriendlyName</option>
                          }
                      }
                    </select>
                    <button class="btn btn-primary"
                            @onclick="() => AddDeviceToGroup(group.Name)"
                            disabled="@(isSubmittingGroup || string.IsNullOrWhiteSpace(selectedDeviceId))">
                    Add Device
                  </button>
              }
            </div>
          }
        </div>

        <div class="manage-device-item" style="margin-top:1rem;">
          <input class="form-control" placeholder="New group name" @bind="newGroupName" @bind:event="oninput" />
          <div class="manage-device-actions">
            <button class="btn btn-primary"
                    @onclick="SubmitCreateGroup"
                    disabled="@(isSubmittingGroup || string.IsNullOrWhiteSpace(newGroupName))">Create Group</button>
          </div>
        </div>
      }

      @if (!string.IsNullOrWhiteSpace(groupErrorMessage))
      {
        <div class="add-device-error">@groupErrorMessage</div>
      }

      <div class="add-device-actions">
        <button class="btn btn-secondary" @onclick="CloseManageGroups">Close</button>
      </div>
    </div>
  </div>
}

@code {
  private bool showAddDevice;
  private string? pendingDeviceId;
  private string friendlyName = "";
  private string? errorMessage;
  private bool isSubmitting;
  private HttpClient? http;

  private bool showManageDevices;
  private bool isLoadingDevices;
  private List<DeviceInfo>? devices;
  private string? editingDeviceId;
  private string editFriendlyName = "";
  private string? manageErrorMessage;

  private bool isLoading = true;
  private List<DeviceGroup> groups = new List<DeviceGroup>();
  private int activeDeviceCount;
  private double? averageTemperature;

  // Manage groups
private bool showManageGroups;
private bool isLoadingGroups;
private List<DeviceGroup> managedGroups = new();
private string? editingGroupName;
private string editGroupNameValue = "";
private string newGroupName = "";
private string? groupErrorMessage;
private bool isSubmittingGroup;
private string selectedDeviceId = "";

  private static readonly (string Icon, string Label, Func<SensorReading?, string> Format)[] SensorDefinitions =
  {
        ("L", "Light", r => r?.Light is not null ? $"{r.Light:0} lx" : "N/A"),
        ("T", "Temperature", r => r?.Temperature is not null ? $"{r.Temperature:0.0}°C" : "N/A"),
        ("H", "Humidity", r => r?.Humidity is not null ? $"{r.Humidity:0}%" : "N/A"),
        ("P", "Pressure", r => r?.Pressure is not null ? $"{r.Pressure:0.00} kPa" : "N/A"),
    };

  protected override async Task OnInitializedAsync()
  {
    http = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
    PendingDeviceStore.Changed += HandlePendingChanged;
    pendingDeviceId = PendingDeviceStore.PendingDeviceId;

    activeDeviceCount = 0;

    await LoadDashboardDataAsync();
  }

  private async Task LoadDashboardDataAsync()
  {
    isLoading = true;

    devices = await DeviceFunctions.GetDevicesAsync();
    groups = await DeviceFunctions.GetDeviceGroupsAsync();

    List<Device>? allGroupDevices = groups.SelectMany(g => g.Devices).ToList();

    foreach (Device dev in allGroupDevices)
    {
      if (DeviceStatus.StatusList[dev.DeviceId])
      {
        activeDeviceCount++;
      }
    }

    IEnumerable<Task>? sensorDataTask = allGroupDevices.Select(async device => {device.LatestReading = await DeviceFunctions.GetLatestSensorDataAsync(device.DeviceId);});
      
    await Task.WhenAll(sensorDataTask);

    List<double>? temps = allGroupDevices
      .Where(d => d.LatestReading?.Temperature is not null)
      .Select(d => d.LatestReading!.Temperature!.Value)
      .ToList();

    averageTemperature = temps.Count > 0 ? temps.Average() : null;

    isLoading = false;
  }

  private static string FormatTemp(double? temp)
      => temp is not null ? $"{temp:0.0}°C" : "--";

  private void HandlePendingChanged()
  {
    _ = InvokeAsync(() =>
    {
      pendingDeviceId = PendingDeviceStore.PendingDeviceId;
      StateHasChanged();
    });
  }

  private void OpenAddDevice()
  {
    showAddDevice = true;
    errorMessage = null;
    pendingDeviceId = PendingDeviceStore.PendingDeviceId;
  }

  private void CancelAddDevice()
  {
    PendingDeviceStore.Clear();
    pendingDeviceId = null;
    friendlyName = "";
    errorMessage = null;
    showAddDevice = false;
  }

  private bool CanSubmit =>
      !isSubmitting &&
      !string.IsNullOrWhiteSpace(pendingDeviceId) &&
      !string.IsNullOrWhiteSpace(friendlyName);

  private async Task SubmitAddDevice()
  {
    if (!CanSubmit || http is null) return;

    isSubmitting = true;
    errorMessage = null;

    try
    {
      DeviceAddRequest? request = new DeviceAddRequest { DeviceId = pendingDeviceId!, FriendlyName = friendlyName };
      var (success, message) = await DeviceFunctions.AddDeviceAsync(request);

      if (success)
      {
        PendingDeviceStore.Clear();
        friendlyName = "";
        pendingDeviceId = null;
        showAddDevice = false;
        await LoadDashboardDataAsync();
      }
      else
      {
        errorMessage = message;
      }
    }
    catch (Exception ex)
    {
      errorMessage = ex.Message;
    }
    finally
    {
      isSubmitting = false;
    }
  }

  private async Task OpenManageDevices()
  {
    showManageDevices = true;
    manageErrorMessage = null;
    editingDeviceId = null;
    await LoadDevices();
  }

  private void CloseManageDevices()
  {
    showManageDevices = false;
    manageErrorMessage = null;
    editingDeviceId = null;
    editFriendlyName = "";
  }

  private async Task LoadDevices()
  {
    isLoadingDevices = true;
    try
    {
      devices = await DeviceFunctions.GetDevicesAsync();
    }
    catch (Exception ex)
    {
      manageErrorMessage = ex.Message;
    }
    finally
    {
      isLoadingDevices = false;
    }
  }

  private void StartEditDevice(DeviceInfo device)
  {
    editingDeviceId = device.DeviceId;
    editFriendlyName = device.FriendlyName;
    manageErrorMessage = null;
  }

  private void CancelEdit()
  {
    editingDeviceId = null;
    editFriendlyName = "";
  }

  private async Task SubmitEditDevice(string deviceId)
  {
    isSubmitting = true;
    manageErrorMessage = null;
    try
    {
      DeviceEditRequest? request = new DeviceEditRequest { DeviceId = deviceId, FriendlyName = editFriendlyName.Trim() };
      var (success, message) = await DeviceFunctions.EditDeviceAsync(request);
      if (success)
      {
        editingDeviceId = null;
        editFriendlyName = "";
        await LoadDevices();
      }
      else
      {
        manageErrorMessage = message;
      }
    }
    catch (Exception ex)
    {
      manageErrorMessage = ex.Message;
    }
    finally
    {
      isSubmitting = false;
    }
  }

  private async Task ToggleDeviceActive(DeviceInfo device)
  {
    isSubmitting = true;
    manageErrorMessage = null;
    try
    {
      DeviceDeleteRequest? request = new DeviceDeleteRequest { DeviceId = device.DeviceId, IsActive = !device.IsActive };
      var (success, message) = await DeviceFunctions.SetDeviceActiveAsync(request);
      if (success)
        await LoadDevices();
      else
        manageErrorMessage = message;
    }
    catch (Exception ex)
    {
      manageErrorMessage = ex.Message;
    }
    finally
    {
      isSubmitting = false;
    }
  }

  public void Dispose()
  {
    PendingDeviceStore.Changed -= HandlePendingChanged;
    http?.Dispose();
  }

  private async Task OpenManageGroups()
{
    showManageGroups = true;
    groupErrorMessage = null;
    editingGroupName = null;
    newGroupName = "";
    await LoadGroupsForManage();
    await LoadDevices();
}

private void CloseManageGroups()
{
  showManageGroups = false;
  groupErrorMessage = null;
  editingGroupName = null;
  editGroupNameValue = "";
  newGroupName = "";
}

private async Task LoadGroupsForManage()
{
  isLoadingGroups = true;
  try
  {
    managedGroups = await DeviceFunctions.GetDeviceGroupsAsync();
  }
  catch (Exception ex)
  {
    groupErrorMessage = ex.Message;
  }
  finally
  {
    isLoadingGroups = false;
  }
}

private void StartEditGroup(string groupName)
{
  editingGroupName = groupName;
  editGroupNameValue = groupName;
  groupErrorMessage = null;
}

private void CancelEditGroup()
{
  editingGroupName = null;
  editGroupNameValue = "";
}

private async Task SubmitEditGroup(string oldName)
{
  isSubmittingGroup = true;
  groupErrorMessage = null;
  try
  {
    GroupEditRequest? request = new GroupEditRequest { GroupName = oldName, NewGroupName = editGroupNameValue.Trim() };
    var (success, message) = await DeviceFunctions.EditGroupAsync(request);
    if(success)
    {
      editingGroupName = null;
      editGroupNameValue = "";
      await LoadGroupsForManage();
      await LoadDashboardDataAsync();
    }
    else
    {
      groupErrorMessage = message;
    }
  }
  catch(Exception ex)
  {
    groupErrorMessage = ex.Message;
  }
  finally
  {
    isSubmittingGroup = false;
  }
}

private async Task DeleteGroup(string groupName)
{
  isSubmittingGroup = true;
  groupErrorMessage = null;
  try
  {
    var (success, message) = await DeviceFunctions.DeleteGroupAsync(groupName);
    if (success)
    {
      await LoadGroupsForManage();
      await LoadDashboardDataAsync();
    }
    else
    {
      groupErrorMessage = message;
    }
  }
  catch(Exception ex)
  {
    groupErrorMessage = ex.Message;
  }
  finally
  {
    isSubmittingGroup = false;
  }
}

private async Task SubmitCreateGroup()
{
  isSubmittingGroup = true;
  groupErrorMessage = null;
  try
  {
    GroupCreateRequest? request = new GroupCreateRequest { GroupName = newGroupName.Trim() };
    var (success, message) = await DeviceFunctions.CreateGroupAsync(request);
    if(success)
    {
      newGroupName = "";
      await LoadGroupsForManage();
      await LoadDashboardDataAsync();
    }
    else
    {
      groupErrorMessage = message;
    }
  }
  catch (Exception ex)
  {
    groupErrorMessage = ex.Message;
  }
  finally
  {
    isSubmittingGroup = false;
  }
}

private async Task AddDeviceToGroup(string groupName)
{
  isSubmittingGroup = true;
  groupErrorMessage = null;

  try
  {
    GroupAddDeviceRequest? request = new GroupAddDeviceRequest { GroupName = groupName, DeviceId = selectedDeviceId };
    var (success, message) = await DeviceFunctions.AddDeviceToGroupAsync(request);

    if(success)
    {
      selectedDeviceId = "";
      await LoadGroupsForManage();
      await LoadDashboardDataAsync();

    }
    else
    {
      groupErrorMessage = message;
    }
  }
  catch (Exception ex)
  {
    groupErrorMessage = ex.Message;
  }
  finally
  {
    isSubmittingGroup = false;
  }
}
}