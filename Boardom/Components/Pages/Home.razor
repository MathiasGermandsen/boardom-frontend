@page "/home"
@using Microsoft.AspNetCore.Components.Authorization;
@using Microsoft.AspNetCore.Authorization;
@using Microsoft.IdentityModel.Abstractions
@using System.Runtime.CompilerServices
@using Boardom.Models
@using Boardom.Services
@implements IDisposable
@inject PendingDeviceStore PendingDeviceStore
@inject NavigationManager NavigationManager
@inject DeviceFunctions DeviceFunctions
@inject GroupFunctions GroupFunctions
@inject DataFunctions DataFunctions
@inject DeviceStatus DeviceStatus

@attribute [Authorize]

<PageTitle>BOARDOM - Household Monitoring System</PageTitle>

@if (isLoading)
{
  <div style="text-align:center;padding:5rem;color:#e8eef7;">Loading dashboard data…</div>
}
else
{
  <div class="dashboard-container">
    <div class="dashboard-header">
      <h1 class="dashboard-title">System Overview</h1>
      <p class="dashboard-subtitle">Real-time monitoring of household sensor devices</p>
      <div class="dashboard-stats">
        <div class="stat-card">
          <div class="stat-icon">●</div>
          <span class="stat-label">ACTIVE DEVICES IN GROUPS</span>
          <span class="stat-value">@activeDeviceCount</span>
        </div>
        <div class="stat-card">
          <div class="stat-icon">●</div>
          <span class="stat-label">DEVICE GROUPS</span>
          <span class="stat-value">@groups.Count</span>
        </div>
        <div class="stat-card">
          <div class="stat-icon">●</div>
          <span class="stat-label">AVERAGE TEMPERATURE</span>
          <span class="stat-value">@FormatTemp(averageTemperature)</span>
        </div>
      </div>
    </div>
    <div class="dashboard-groups">
      @foreach (Group group in groups)
      {
        <div class="dashboard-group">
          <div class="group-header">
            <h2>@group.Name</h2>
            <span class="device-count">@group.Devices.Count device@(group.Devices.Count != 1 ? "s" : "")</span>
          </div>
          <div class="arduino-list">
            @foreach (Device device in group.Devices)
            {
              <div class="arduino-card">
                <div class="card-header">
                  <h3>@device.FriendlyName</h3>
                  @if (DeviceStatus.StatusList[device.DeviceId])
                  {
                    <span class="device-status online">● Online</span>
                  }
                  else
                  {
                    <span class="device-status offline">● Offline</span>
                  }
                 <button class="btn btn-danger btn-sm" @onclick="() => PromptRemoveDeviceFromGroup(group.Name, device.DeviceId, device.FriendlyName)">✕</button>
                </div>
                <div class="sensor-data">
                  @{
                    var disabled = !DeviceStatus.StatusList[device.DeviceId] || device.LatestReading is null;
                  }
                  @foreach (var sensor in SensorDefinitions)
                  {
                    <div class="sensor-item @(disabled ? "disabled" : "")">
                      <div class="sensor-info">
                        <span class="sensor-icon">@sensor.Icon</span>
                        <span class="sensor-label">@sensor.Label</span>
                      </div>
                      <span class="sensor-value">@sensor.Format(device.LatestReading)</span>
                    </div>
                  }
                </div>
              </div>
            }
          </div>
        </div>
      }
    </div>
  </div>
}

@* Single FAB with popup menu *@
<div class="fab-container @(showFabMenu ? "open" : "")">
    @if (showFabMenu)
    {
        <div class="fab-menu">
            <div class="fab-menu-item" @onclick="OpenAddDevice">
                <span class="fab-menu-label">Add device</span>
                <span class="fab-menu-icon">+</span>
            </div>
            <div class="fab-menu-item" @onclick="OpenManageDevices">
                <span class="fab-menu-label">Edit devices</span>
                <span class="fab-menu-icon">✎</span>
            </div>
            <div class="fab-menu-item" @onclick="OpenManageGroups">
                <span class="fab-menu-label">Edit groups</span>
                <span class="fab-menu-icon">⊟</span>
            </div>
        </div>
    }
    <button type="button"
            class="fab-main @(showFabMenu ? "open" : "")"
            @onclick="ToggleFabMenu"
            aria-label="Actions">+</button>
</div>


@if (showAddDevice)
{
  <div class="add-device-overlay">
    <div class="add-device-modal" @onclick:stopPropagation="true">
      <h1 class="add-device-title">ADD DEVICE</h1>

      @if (string.IsNullOrWhiteSpace(pendingDeviceId))
      {
        <p class="add-device-waiting">Waiting for device...</p>

        <div class="add-device-actions">
          <button class="btn btn-secondary" @onclick="CancelAddDevice">Cancel</button>
        </div>
      }
      else
      {
        <p class="add-device-found">
          Device connected: <span class="device-id">@pendingDeviceId</span>
        </p>

        <div class="add-device-form">
          <label>Friendly name</label>
          <input class="form-control" @bind="friendlyName" @bind:event="oninput" />
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
          <div class="add-device-error">@errorMessage</div>
        }

        <div class="add-device-actions">
          <button class="btn btn-secondary" @onclick="CancelAddDevice" disabled="@isSubmitting">Cancel</button>
          <button class="btn btn-primary" @onclick="SubmitAddDevice" disabled="@(!CanSubmit)">Add</button>
        </div>
      }
    </div>
  </div>
}

@if (showManageDevices)
{
  <div class="add-device-overlay">
    <div class="add-device-modal" @onclick:stopPropagation="true">
      <h1 class="add-device-title">MANAGE DEVICES</h1>

      @if (isLoadingDevices)
      {
        <p class="add-device-waiting">Loading devices...</p>
      }
      else if (devices == null || !devices.Any())
      {
        <p class="add-device-waiting">No devices found.</p>
      }
      else
      {
        <div class="manage-device-list">
          @foreach (Device device in devices)
          {
            <div class="manage-device-item">
              @if (editingDeviceId == device.DeviceId)
              {
                <div class="manage-device-edit">
                  <input class="form-control" @bind="editFriendlyName" @bind:event="oninput" />
                  <div class="manage-device-actions">
                    <button class="btn btn-primary" @onclick="() => SubmitEditDevice(device.DeviceId)"
                            disabled="@(isSubmitting || string.IsNullOrWhiteSpace(editFriendlyName))">Save</button>
                    <button class="btn btn-secondary" @onclick="CancelEdit" disabled="@isSubmitting">Cancel</button>
                  </div>
                </div>
              }
              else
              {
                <div class="manage-device-info">
                  <span class="device-friendly-name">@device.FriendlyName</span>
                  <span class="device-id-small">@device.DeviceId</span>
                  <span class="device-state @(!DeviceStatus.StatusList[device.DeviceId] ? "online" : "offline")">
                  @if (DeviceStatus.StatusList[device.DeviceId])
                  {
                    <p style="font-weight: bold; color:#047857; ">● Online</p>
                  }
                  else
                  {
                    <p style="color: #991b1b; font-weight: bold;">● Offline</p>
                  }
                  </span>
                </div>
                <div class="manage-device-actions">
                  <button class="btn btn-secondary" @onclick="() => StartEditDevice(device)"
                          disabled="@isSubmitting">Edit</button>
                  <button class="btn btn-danger" @onclick="() => ToggleDeviceActive(device)" disabled="@isSubmitting">
                    Delete
                  </button>
                </div>
              }
            </div>
          }
        </div>
      }

      @if (!string.IsNullOrWhiteSpace(manageErrorMessage))
      {
        <div class="add-device-error">@manageErrorMessage</div>
      }

      <div class="add-device-actions">
        <button class="btn btn-secondary" @onclick="CloseManageDevices">Close</button>
      </div>
    </div>
  </div>
}

@if (showManageGroups)
{
  <div class="add-device-overlay">
    <div class="add-device-modal" @onclick:stopPropagation="true">
      <h1 class="add-device-title">MANAGE GROUPS</h1>

      @if (isLoadingGroups)
      {
        <p class="add-device-waiting">Loading groups...</p>
      }
      else
      {
        <div class="manage-device-list">
          @foreach (Group group in managedGroups)
          {
            <div class="manage-group-item">
              @if (editingGroupName == group.Name)
              {
                <div class="manage-device-edit" style="align-items: flex-end;">
                  <div style="display:flex; flex-direction:column; gap:0.25rem; flex:1;">
                    <span style="font-size:0.75rem; color:#7a8fa3; font-weight:600; letter-spacing:0.5px; text-transform:uppercase;">Name</span>
                    <input class="form-control" @bind="editGroupNameValue" @bind:event="oninput" />
                  </div>
                  <div class="manage-device-actions">
                  <button class="btn btn-primary"
                          @onclick="() => SubmitEditGroup(group.Name)"
                          disabled="@(isSubmittingGroup || string.IsNullOrWhiteSpace(editGroupNameValue))">Save</button>
                  <button class="btn btn-secondary" @onclick="CancelEditGroup" disabled="@isSubmittingGroup">Cancel</button>
                </div>
              </div>
              }
              else
              {
              <div class="manage-group-row">
                <div class="manage-device-info">
                  <span class="device-friendly-name">@group.Name</span>
                  <span class="device-id-small">@group.Devices.Count device(s)</span>
                </div>
                <select class="form-control"
                        value="@(selectedDeviceIds.GetValueOrDefault(group.Name, ""))"
                        @onchange="@(e => selectedDeviceIds[group.Name] = e.Value?.ToString() ?? string.Empty)">
                  <option value="">— Add device —</option>
                  @if (devices != null)
                  {
                    @foreach (Device d in devices)
                    {
                      <option value="@d.DeviceId">@d.FriendlyName</option>
                    }
                  }
                </select>
                <button class="btn btn-primary"
                        @onclick="() => AddDeviceToGroup(group.Name)"
                        disabled="@(isSubmittingGroup || string.IsNullOrWhiteSpace(selectedDeviceIds.GetValueOrDefault(group.Name)))">
                  Add
                </button>
                <button class="btn btn-secondary" @onclick="() => StartEditGroup(group.Name)" disabled="@isSubmittingGroup">Edit</button>
                <button class="btn btn-danger" @onclick="() => DeleteGroup(group.Name)" disabled="@isSubmittingGroup">Delete</button>
              </div>
              }
            </div>
          }
        </div>

        <div class="manage-group-create">
          <input class="form-control" placeholder="New group name" @bind="newGroupName" @bind:event="oninput" />
          <button class="btn btn-primary"
                  @onclick="SubmitCreateGroup"
                  disabled="@(isSubmittingGroup || string.IsNullOrWhiteSpace(newGroupName))">Create</button>
        </div>
      }

      @if (!string.IsNullOrWhiteSpace(groupErrorMessage))
      {
        <div class="add-device-error">@groupErrorMessage</div>
      }

      <div class="add-device-actions">
        <button class="btn btn-secondary" @onclick="CloseManageGroups">Close</button>
      </div>
    </div>
  </div>
}

@if (showConfirmRemove)
{
  <div class="add-device-overlay">
    <div class="add-device-modal" @onclick:stopPropagation="true">
      <h1 class="add-device-title">REMOVE DEVICE</h1>
      <p style="color:#e8eef7;margin-bottom:1.5rem; text-align: center">
        Remove <strong>@confirmRemoveDeviceName</strong> from this group?
      </p>
      <div class="add-device-actions">
        <button class="btn btn-secondary" @onclick="CancelRemoveDeviceFromGroup">Cancel</button>
        <button class="btn btn-danger" @onclick="ConfirmRemoveDeviceFromGroup">Remove</button>
      </div>
    </div>
  </div>
}

@code {

// --------------- Dashboard ---------------
  private bool isLoading = true;
  private bool isLoadingDevices;
  private List<Group> groups = new List<Group>();
  private List<Device>? devices;
  private List<string>? addedDeviceIds = new List<string>();
  private int activeDeviceCount;
  private double? averageTemperature;
  // --------------- Add Device ---------------
  private bool showAddDevice;
  private string? pendingDeviceId;
  private string friendlyName = "";
  private string? errorMessage;
  private bool isSubmitting;
  private bool CanSubmit => !isSubmitting && !string.IsNullOrWhiteSpace(pendingDeviceId) && !string.IsNullOrWhiteSpace(friendlyName);

  // --------------- Manage Device ---------------
  private bool showManageDevices;
  private string? editingDeviceId;
  private string editFriendlyName = "";
  private string? manageErrorMessage;

  // --------------- Manage Groups ---------------
  private bool showManageGroups;
  private bool isLoadingGroups;
  private List<Group> managedGroups = new List<Group>();
  private string? editingGroupName;
  private string editGroupNameValue = "";
  private string newGroupName = "";
  private string? groupErrorMessage;
  private bool isSubmittingGroup;
  private Dictionary<string, string> selectedDeviceIds = new();

// --------------- remove from group confirmation pop up ---------------
  private bool showConfirmRemove;
  private string confirmRemoveGroupName = "";
  private string confirmRemoveDeviceId = "";
  private string confirmRemoveDeviceName = "";

  private static readonly (string Icon, string Label, Func<SensorReading?, string> Format)[] SensorDefinitions =
  {
        ("L", "Light", r => r?.Light is not null ? $"{r.Light:0} lx" : "N/A"),
        ("T", "Temperature", r => r?.Temperature is not null ? $"{r.Temperature:0.0}°C" : "N/A"),
        ("H", "Humidity", r => r?.Humidity is not null ? $"{r.Humidity:0}%" : "N/A"),
        ("P", "Pressure", r => r?.Pressure is not null ? $"{r.Pressure:0.00} kPa" : "N/A"),
    };

  protected override async Task OnInitializedAsync()
  {
    PendingDeviceStore.Changed += HandlePendingChanged;
    pendingDeviceId = PendingDeviceStore.PendingDeviceId;

    activeDeviceCount = 0;

    await LoadDashboardDataAsync();
  }

  private async Task LoadDashboardDataAsync()
  {
    isLoading = true;

    devices = await DeviceFunctions.GetAllDevices();
    groups = await GroupFunctions.GetAllGroups();

    List<Device>? allGroupDevices = groups.SelectMany(g => g.Devices).ToList();
    
    foreach (Device dev in allGroupDevices)
    {
      if (addedDeviceIds!.Contains(dev.DeviceId))
      {
        continue;
      }

      if (DeviceStatus.StatusList[dev.DeviceId])
      {
        activeDeviceCount++;
      }

      addedDeviceIds.Add(dev.DeviceId);
    }
    
    List<double>? temps = devices
      .Where(d => d.LatestReading?.Temperature is not null)
      .Select(d => d.LatestReading!.Temperature!)
      .ToList();

    averageTemperature = temps.Count > 0 ? temps.Average() : null;

    isLoading = false;
  }

  private static string FormatTemp(double? temp)
      => temp is not null ? $"{temp:0.0}°C" : "--";

  private void HandlePendingChanged()
  {
    _ = InvokeAsync(() =>
    {
      pendingDeviceId = PendingDeviceStore.PendingDeviceId;
      StateHasChanged();
    });
  }

  private void OpenAddDevice()
  {
    showFabMenu = false;
    showAddDevice = true;
    errorMessage = null;
    pendingDeviceId = PendingDeviceStore.PendingDeviceId;
  }

  private void CancelAddDevice()
  {
    PendingDeviceStore.Clear();
    pendingDeviceId = null;
    friendlyName = "";
    errorMessage = null;
    showAddDevice = false;
  }

  private async Task SubmitAddDevice()
  {
    if (!CanSubmit) return;

    isSubmitting = true;
    errorMessage = null;

    try
    {
      DeviceAdd? request = new DeviceAdd()
      {
        DeviceId = pendingDeviceId!, 
        FriendlyName = friendlyName
      };
      
      ReturnStatusObject response = await DeviceFunctions.AddDevice(request);

      if (response.Success)
      {
        PendingDeviceStore.Clear();
        friendlyName = "";
        pendingDeviceId = null;
        showAddDevice = false;
        await LoadDashboardDataAsync();
      }
      else
      {
        errorMessage = response.Message;
      }
    }
    catch (Exception ex)
    {
      errorMessage = ex.Message;
    }
    finally
    {
      isSubmitting = false;
    }
  }

  private async Task OpenManageDevices()
  {
    showFabMenu = false;
    showManageDevices = true;
    manageErrorMessage = null;
    editingDeviceId = null;
    await LoadDevices();
  }

  private void CloseManageDevices()
  {
    showManageDevices = false;
    manageErrorMessage = null;
    editingDeviceId = null;
    editFriendlyName = "";
  }

  private async Task LoadDevices()
  {
    isLoadingDevices = true;
    try
    {
      devices = await DeviceFunctions.GetAllDevices();
    }
    catch (Exception ex)
    {
      manageErrorMessage = ex.Message;
    }
    finally
    {
      isLoadingDevices = false;
    }
  }

  private void StartEditDevice(Device device)
  {
    editingDeviceId = device.DeviceId;
    editFriendlyName = device.FriendlyName;
    manageErrorMessage = null;
  }

  private void CancelEdit()
  {
    editingDeviceId = null;
    editFriendlyName = "";
  }

  private async Task SubmitEditDevice(string deviceId)
  {
    isSubmitting = true;
    manageErrorMessage = null;
    try
    {
      DeviceEdit? request = new DeviceEdit()
      {
        DeviceId = deviceId, 
        NewFriendlyName = editFriendlyName.Trim()
      };
      ReturnStatusObject response = await DeviceFunctions.EditDevice(request);
      
      if (response.Success)
      {
        editingDeviceId = null;
        editFriendlyName = "";
        await LoadDevices();
      }
      else
      {
        manageErrorMessage = response.Message;
      }
    }
    catch (Exception ex)
    {
      manageErrorMessage = ex.Message;
    }
    finally
    {
      isSubmitting = false;
    }
  }

  private async Task ToggleDeviceActive(Device device)
  {
    isSubmitting = true;
    manageErrorMessage = null;
    try
    {
      DeviceDelete? request = new DeviceDelete()
      {
        DeviceId = device.DeviceId
      };
      
      ReturnStatusObject response = await DeviceFunctions.DeleteDevice(request);

      if (response.Success)
      {
        await LoadDevices();
      }
      else
      {
        manageErrorMessage = response.Message;
      }
    }
    catch (Exception ex)
    {
      manageErrorMessage = ex.Message;
    }
    finally
    {
      isSubmitting = false;
    }
  }

  public void Dispose()
  {
    PendingDeviceStore.Changed -= HandlePendingChanged;
  }

  private async Task OpenManageGroups()
  {
    showFabMenu = false;
    showManageGroups = true;
    groupErrorMessage = null;
    editingGroupName = null;
    newGroupName = "";
    await LoadGroupsForManage();
    await LoadDevices();
  }

  private void CloseManageGroups()
  {
    showManageGroups = false;
    groupErrorMessage = null;
    editingGroupName = null;
    editGroupNameValue = "";
    newGroupName = "";
  }

  private async Task LoadGroupsForManage()
  {
    isLoadingGroups = true;
    try
    {
      managedGroups = await GroupFunctions.GetAllGroups();
    }
    catch (Exception ex)
    {
      groupErrorMessage = ex.Message;
    }
    finally
    {
      isLoadingGroups = false;
    }
  }

  private void StartEditGroup(string groupName)
  {
    editingGroupName = groupName;
    editGroupNameValue = groupName;
    groupErrorMessage = null;
  }

  private void CancelEditGroup()
  {
    editingGroupName = null;
    editGroupNameValue = "";
  }

  private async Task SubmitEditGroup(string oldName)
  {
    isSubmittingGroup = true;
    groupErrorMessage = null;
    try
    {
      GroupEdit? request = new GroupEdit()
      {
        Name = oldName, 
        NewName = editGroupNameValue.Trim()
      };
      
      ReturnStatusObject response = await GroupFunctions.EditGroup(request);
      
      if(response.Success)
      {
        editingGroupName = null;
        editGroupNameValue = "";
        await LoadGroupsForManage();
        await LoadDashboardDataAsync();
      }
      else
      {
        groupErrorMessage = response.Message;
      }
    }
    catch(Exception ex)
    {
      groupErrorMessage = ex.Message;
    }
    finally
    {
      isSubmittingGroup = false;
    }
  }

  private async Task DeleteGroup(string groupName)
  {
    isSubmittingGroup = true;
    groupErrorMessage = null;
    try
    {
      ReturnStatusObject response = await GroupFunctions.DeleteGroup(groupName);
      
      if (response.Success)
      {
        await LoadGroupsForManage();
        await LoadDashboardDataAsync();
      }
      else
      {
        groupErrorMessage = response.Message;
      }
    }
    catch(Exception ex)
    {
      groupErrorMessage = ex.Message;
    }
    finally
    {
      isSubmittingGroup = false;
    }
  }

  private async Task SubmitCreateGroup()
  {
    isSubmittingGroup = true;
    groupErrorMessage = null;
    try
    {
      GroupCreate? request = new GroupCreate
      {
        Name = newGroupName.Trim()
      };
      
      ReturnStatusObject response = await GroupFunctions.CreateGroup(request);
      
      if(response.Success)
      {
        newGroupName = "";
        await LoadGroupsForManage();
        await LoadDashboardDataAsync();
      }
      else
      {
        groupErrorMessage = response.Message;
      }
    }
    catch (Exception ex)
    {
      groupErrorMessage = ex.Message;
    }
    finally
    {
      isSubmittingGroup = false;
    }
  }

  private async Task AddDeviceToGroup(string groupName)
  {
    isSubmittingGroup = true;
    groupErrorMessage = null;

    try
    {
      string deviceId = selectedDeviceIds.GetValueOrDefault(groupName,"");
      
      GroupManageDevice? request = new GroupManageDevice
      {
        Name = groupName, 
        DeviceId = deviceId
      };
      
      ReturnStatusObject response = await GroupFunctions.AddDeviceToGroup(request);

      if(response.Success)
      {
        selectedDeviceIds.Remove(groupName);
        await LoadGroupsForManage();
        await LoadDashboardDataAsync();
      }
      else
      {
        groupErrorMessage = response.Message;
      }
    }
    catch (Exception ex)
    {
      groupErrorMessage = ex.Message;
    }
    finally
    {
      isSubmittingGroup = false;
    }
  }

  private void PromptRemoveDeviceFromGroup(string groupName, string deviceId, string deviceName)
  {
    confirmRemoveGroupName = groupName;
    confirmRemoveDeviceId = deviceId;
    confirmRemoveDeviceName = deviceName;
    showConfirmRemove = true;
  }

  private void CancelRemoveDeviceFromGroup()
  {
    showConfirmRemove = false;
    confirmRemoveGroupName = "";
    confirmRemoveDeviceName = "";
    confirmRemoveDeviceId = "";
  }

  private async Task ConfirmRemoveDeviceFromGroup()
  {
    showConfirmRemove = false;
    await RemoveDeviceFromGroup(confirmRemoveGroupName, confirmRemoveDeviceId);
    confirmRemoveGroupName = "";
    confirmRemoveDeviceId = "";
    confirmRemoveDeviceName = "";
  }

  private async Task RemoveDeviceFromGroup(string groupName, string deviceId)
  {
    try
    {
      GroupManageDevice? request = new GroupManageDevice
      {
        Name = groupName, 
        DeviceId = deviceId
      };
      
     ReturnStatusObject response = await GroupFunctions.RemoveDeviceFromGroup(request);
      
      if(response.Success)
      {
        await LoadDashboardDataAsync();
      }
    }
    catch(Exception ex)
    {
      _=ex;
    }
  }

  private bool showFabMenu = false;

  private void ToggleFabMenu()
  {
      showFabMenu = !showFabMenu;
  }
}
