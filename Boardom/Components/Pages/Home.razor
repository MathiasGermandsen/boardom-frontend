@page "/home"

<PageTitle>BOARDOM - Household Monitoring System</PageTitle>

<div class="dashboard-container">
	<div class="dashboard-header">
		<h1 class="dashboard-title">System Overview</h1>
		<p class="dashboard-subtitle">Real-time monitoring of household sensor devices</p>
		<div class="dashboard-stats">
			<div class="stat-card">
				<div class="stat-icon">●</div>
				<span class="stat-label">ACTIVE DEVICES</span>
				<span class="stat-value">5</span>
			</div>
			<div class="stat-card">
				<div class="stat-icon">●</div>
				<span class="stat-label">DEVICE GROUPS</span>
				<span class="stat-value">3</span>
			</div>
			<div class="stat-card">
				<div class="stat-icon">●</div>
				<span class="stat-label">AVERAGE TEMPERATURE</span>
				<span class="stat-value">21.1°C</span>
			</div>
		</div>
	</div>
	<div class="dashboard-groups">
		<!-- Living Room Group -->
		<div class="dashboard-group">
			<div class="group-header">
				<h2>Living Room</h2>
				<span class="device-count">2 devices</span>
			</div>
			<div class="arduino-list">
				<div class="arduino-card">
					<div class="card-header">
						<h3>Main Sensor</h3>
						<span class="device-status online">● Online</span>
					</div>
					<div class="sensor-data">
						<div class="sensor-item">
							<div class="sensor-info">
								<span class="sensor-icon">L</span>
								<span class="sensor-label">Light</span>
							</div>
							<span class="sensor-value">350 lx</span>
						</div>
						<div class="sensor-item">
							<div class="sensor-info">
								<span class="sensor-icon">T</span>
								<span class="sensor-label">Temperature</span>
							</div>
							<span class="sensor-value">22.5°C</span>
						</div>
						<div class="sensor-item">
							<div class="sensor-info">
								<span class="sensor-icon">H</span>
								<span class="sensor-label">Humidity</span>
							</div>
							<span class="sensor-value">45%</span>
						</div>
					</div>
				</div>
				<div class="arduino-card">
					<div class="card-header">
						<h3>Secondary Sensor</h3>
						<span class="device-status online">● Online</span>
					</div>
					<div class="sensor-data">
						<div class="sensor-item">
							<div class="sensor-info">
								<span class="sensor-icon">L</span>
								<span class="sensor-label">Light</span>
							</div>
							<span class="sensor-value">120 lx</span>
						</div>
						<div class="sensor-item">
							<div class="sensor-info">
								<span class="sensor-icon">T</span>
								<span class="sensor-label">Temperature</span>
							</div>
							<span class="sensor-value">20.1°C</span>
						</div>
						<div class="sensor-item">
							<div class="sensor-info">
								<span class="sensor-icon">H</span>
								<span class="sensor-label">Humidity</span>
							</div>
							<span class="sensor-value">50%</span>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- Bedroom Group -->
		<div class="dashboard-group">
			<div class="group-header">
				<h2>Bedroom</h2>
				<span class="device-count">1 device</span>
			</div>
			<div class="arduino-list">
				<div class="arduino-card">
					<div class="card-header">
						<h3>Climate Sensor</h3>
						<span class="device-status online">● Online</span>
					</div>
					<div class="sensor-data">
						<div class="sensor-item">
							<div class="sensor-info">
								<span class="sensor-icon">L</span>
								<span class="sensor-label">Light</span>
							</div>
							<span class="sensor-value">80 lx</span>
						</div>
						<div class="sensor-item">
							<div class="sensor-info">
								<span class="sensor-icon">T</span>
								<span class="sensor-label">Temperature</span>
							</div>
							<span class="sensor-value">19.8°C</span>
						</div>
						<div class="sensor-item">
							<div class="sensor-info">
								<span class="sensor-icon">H</span>
								<span class="sensor-label">Humidity</span>
							</div>
							<span class="sensor-value">55%</span>
						</div>
					</div>
				</div>
			</div>
		</div>
		<!-- Kitchen Group -->
		<div class="dashboard-group">
			<div class="group-header">
				<h2>Kitchen</h2>
				<span class="device-count">2 devices</span>
			</div>
			<div class="arduino-list">
				<div class="arduino-card">
					<div class="card-header">
						<h3>Ambient Sensor</h3>
						<span class="device-status online">● Online</span>
					</div>
					<div class="sensor-data">
						<div class="sensor-item">
							<div class="sensor-info">
								<span class="sensor-icon">L</span>
								<span class="sensor-label">Light</span>
							</div>
							<span class="sensor-value">450 lx</span>
						</div>
						<div class="sensor-item">
							<div class="sensor-info">
								<span class="sensor-icon">T</span>
								<span class="sensor-label">Temperature</span>
							</div>
							<span class="sensor-value">23.2°C</span>
						</div>
						<div class="sensor-item">
							<div class="sensor-info">
								<span class="sensor-icon">H</span>
								<span class="sensor-label">Humidity</span>
							</div>
							<span class="sensor-value">42%</span>
						</div>
					</div>
				</div>
				<div class="arduino-card">
					<div class="card-header">
						<h3>Ventilation Monitor</h3>
						<span class="device-status offline">● Offline</span>
					</div>
					<div class="sensor-data">
						<div class="sensor-item disabled">
							<div class="sensor-info">
								<span class="sensor-icon">L</span>
								<span class="sensor-label">Light</span>
							</div>
							<span class="sensor-value">N/A</span>
						</div>
						<div class="sensor-item disabled">
							<div class="sensor-info">
								<span class="sensor-icon">T</span>
								<span class="sensor-label">Temperature</span>
							</div>
							<span class="sensor-value">N/A</span>
						</div>
						<div class="sensor-item disabled">
							<div class="sensor-info">
								<span class="sensor-icon">H</span>
								<span class="sensor-label">Humidity</span>
							</div>
							<span class="sensor-value">N/A</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@* Styling is in wwwroot/app.css *@