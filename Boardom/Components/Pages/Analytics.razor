@page "/analytics"
@using Boardom.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Boardom.Services
@using System.Linq
@using System.Reflection.Metadata.Ecma335

@inject NavigationManager NavigationManager
@inject DeviceFunctions DeviceFunctions
@inject DeviceStatus DeviceStatus
@inject IJSRuntime JS

<PageTitle>BOARDOM - Analytics</PageTitle>

<div class="analytics-container">
    <div class="analytics-header">
        <h1 class="analytics-title">Analytics</h1>
        <p class="analytics-subtitle">View and analyze device data</p>
    </div>

    <!-- Device Selection Modal -->
    @if (!selected)
    {
        <div class="analytics-overlay">
            <div class="analytics-modal">
                <h2 class="modal-title">Select Device or Group</h2>
                <p class="modal-subtitle">Choose a device or group to analyze</p>

                <div class="selection-mode">
                    <label>
                        <input type="radio" name="selectionMode" checked="@(selectionMode == "Devices")" @onchange='() => selectionMode = "Devices"' />
                        Devices
                    </label>
                    <label>
                        <input type="radio" name="selectionMode" checked="@(selectionMode == "Groups")" @onchange='() => selectionMode = "Groups"' />
                        Groups
                    </label>
                </div>

                @if (selectionMode == "Devices")
                {
                    <div class="device-list">
                        @foreach (Device device in deviceList)
                        {
                           <div class="device-item" @onclick="() => SelectDevice(device)">
                                <span class="device-name">@device.Name</span>
                                @if (DeviceStatus.StatusList[device.DeviceId])
                                {
                                    <span class="device-status online">Online</span>
                                }
                                else
                                {
                                    <span class="device-status offline">Offline</span>
                                }
                           </div> 
                        }
                    </div>
                }
                else
                {
                    <div class="group-list">
                        @foreach (DeviceGroup group in groupList)
                        {
                           <div class="group-item" @onclick="() => SelectGroup(group)">
                                <span class="group-name">@group.Name</span>
                                <span class="group-device-count">@group.Devices.Count devices</span>
                           </div> 
                        }
                    </div>
                }

                <div class="modal-actions">
                    <button class="btn btn-secondary" @onclick="CancelSelection">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (selected)
    {
        <div class="analytics-controls">
            <div class="selected-device-display" @onclick="ChangeDevice">
                <span class="selected-device-label">Selected:</span>
                <span class="selected-device-name">@(selectedDevice?.Name ?? selectedGroup?.Name)</span>
            </div>
            
            <div class="control-group">
                <label class="control-label">Data Type</label>
                <select class="form-control analytics-select" @bind="selectedDataType">
                    <option value="Temperature">Temperature</option>
                    <option value="Humidity">Humidity</option>
                    <option value="Light">Light Level</option>
                    <option value="Pressure">Pressure</option>
                </select>
            </div>

            <div class="control-group">
                <label class="control-label">Start Date</label>
                <input type="date" class="form-control analytics-date" @bind="startDate"/>
            </div>

            <div class="control-group">
                <label class="control-label">End Date</label>
                <input type="date" class="form-control analytics-date" @bind="endDate"/>
            </div>

            <div class="control-group">
                <label class="control-label">Data Thinning Factor</label>
                <select class="form-control analytics-select" @bind="thinningFactor">
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="7">7</option>
                    <option value="8">8</option>
                </select>
            </div>

            <div class="control-actions">
                <button class="btn btn-primary" @onclick="ShowData">View Data</button>
            </div>
        </div>

        @if (showData)
        {
            <div class="analytics-content">
                @if (isLoadingData)
                {
                    <div class="chart-loading" style="text-align:center;padding:5rem;">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                }
                else
                {
                    <h3 style="text-align:center; font-family: inherit;">Max: @maxValue | Min: @minValue | Avg: @avgValue</h3>
                    <canvas id="analyticsChart" class="w-100" style="max-height:500px; height:500px;" ></canvas>
                }
            </div>
        }
        else
        {
        <div class="analytics-content">
            @if (!string.IsNullOrEmpty(noDataMessage))
            {
                <div class="no-data alert alert-warning">@noDataMessage</div>
            }
            else
            {
                <div class="chart-placeholder">
                    <div class="chart-icon">📊</div>
                    <p class="chart-text">Chart visualization will appear here</p>
                </div>
            }
        </div>
        }
    }
</div>

@code {

    private class DataObject
    {
        public double? Data { get; set;}
        public DateTime Time { get; set;}
    }

    private bool shouldRenderChart = false;
    private List<object> pendingDatasets = new List<object>();

    private double? maxValue = 0;
    private double? minValue = Int32.MaxValue;
    private double? avgValue = 0;

    List<Device> deviceList = new List<Device>();
    List<DeviceGroup> groupList = new List<DeviceGroup>();

    List<DataObject> singleData = new List<DataObject>();
    Dictionary<string, List<DataObject>> groupData = new Dictionary<string, List<DataObject>>();

    private Device? selectedDevice;
    private DeviceGroup? selectedGroup;

    private bool selected = false;
    private bool showData = false;
    private bool isLoadingData = false;
    private List<string> labels = new List<string>();
    private string noDataMessage = string.Empty;
    private string selectedDataType = "Temperature";
    private DateTime startDate = DateTime.Now;
    private DateTime endDate = DateTime.Now.AddDays(1);
    private string selectionMode = "Devices";

    private int thinningFactor = 1;

    protected override async Task OnInitializedAsync()
    {
        deviceList = await DeviceFunctions.GetAllDevicesAsync();
        groupList = await DeviceFunctions.GetDeviceGroupsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (shouldRenderChart)
    {
        shouldRenderChart = false;
        await JS.InvokeVoidAsync("renderLineChart", pendingDatasets);
    }
}

    private void CancelSelection()
    {
        NavigationManager.NavigateTo("/home");
    }

    private void SelectDevice(Device device)
    {
        selected = true;
        selectedDevice = device;
        selectedGroup = null;
    }

    private void SelectGroup(DeviceGroup group)
    {
        selected = true;
        selectedGroup = group;
        selectedDevice = null;
    }

    private void ChangeDevice()
    {
        selected = false;
        showData = false;
        selectedDevice = null;
        selectedGroup = null;
    }

    private async Task ShowData()
    {
        if (selectedDevice == null && selectedGroup == null)
        {
            return;
        }

        if (isLoadingData)
        {
            return;
        }

        maxValue = 0;
        minValue = Int32.MaxValue;
        avgValue = 0;

        isLoadingData = true;
        showData = true;
        noDataMessage = string.Empty;
        await InvokeAsync(StateHasChanged);

        singleData.Clear();
        groupData.Clear();
        labels.Clear();

        if (selectedDevice != null)
        {
            // Single Device
            int currentPage = 1;
            List<SensorReading> allData = new List<SensorReading>();

            while (true)
            {
                allData.AddRange(await DeviceFunctions.GetFilteredSensorDataAsync(
                selectedDevice.DeviceId,
                selectedDataType,
                startDate,
                endDate,
                currentPage));
                
                if (allData.Count < (100 * currentPage))
                {
                    break;
                }
                else
                {
                    currentPage++;
                }
            }

            allData = allData.OrderBy(r => r.DateAdded).ToList();

            if (allData.Count > thinningFactor)
            {
                allData = allData
                    .Where((_, idx) => idx % thinningFactor == 0)
                    .ToList();
            }

            if (allData == null || allData.Count == 0)
            {
                noDataMessage = "No data available for the selected device/date/type.";
                showData = false;
                isLoadingData = false;
                await InvokeAsync(StateHasChanged);
                return;
            }

            foreach (SensorReading data in allData)
            {
                DataObject dataObj = new DataObject();
                dataObj.Data = GetValue(data);

                if (dataObj.Data == 0)
                {
                    continue;
                }

                dataObj.Time = data.DateAdded;
                singleData.Add(dataObj);

                maxValue = dataObj.Data > maxValue ? dataObj.Data : maxValue;
                minValue = dataObj.Data < minValue ? dataObj.Data : minValue;
                avgValue += dataObj.Data;
            }

            avgValue = Math.Round(avgValue.Value / singleData.Count, 2);
            

        }
        else if (selectedGroup != null)
        {
            // Group logic
            int count = 0;

            foreach (Device device in selectedGroup.Devices)
            {
                int currentPage = 1;
                List<SensorReading> allData = new List<SensorReading>();

                while (true)
                {
                    allData.AddRange(await DeviceFunctions.GetFilteredSensorDataAsync(
                    device.DeviceId,
                    selectedDataType,
                    startDate,
                    endDate,
                    currentPage));
                    
                    if (allData.Count < (100 * currentPage))
                    {
                        break;
                    }
                    else
                    {
                        currentPage++;
                    }
                }

                allData = allData.OrderBy(r => r.DateAdded).ToList();

                if (allData.Count > thinningFactor)
                {
                    allData = allData
                        .Where((_, idx) => idx % thinningFactor == 0)
                        .ToList();
                }

                if (allData == null || allData.Count == 0)
                {
                    // Just skip this device
                    continue;
                }

                List<DataObject> tempData = new List<DataObject>();

                foreach (SensorReading data in allData)
                {
                    DataObject dataObj = new DataObject();
                    dataObj.Data = GetValue(data);

                    if (dataObj.Data == 0)
                    {
                        continue;
                    }

                    dataObj.Time = data.DateAdded;
                    tempData.Add(dataObj);

                    maxValue = dataObj.Data > maxValue ? dataObj.Data : maxValue;
                    minValue = dataObj.Data < minValue ? dataObj.Data : minValue;
                    avgValue += dataObj.Data;

                    count++;
                }

                groupData[device.Name] = tempData;

                if (groupData.Count == 0)
                {
                    noDataMessage = "No data available for the selected group/date/type.";
                    showData = false;
                    isLoadingData = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }

            avgValue = Math.Round(avgValue.Value / count, 2);
        }

        noDataMessage = string.Empty;
        showData = true;
        isLoadingData = false;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();

        List<object> datasets = new List<object>();

        if (selectedDevice != null)
        {
            datasets.Add(new {
                label = selectedDevice.Name,
                data = singleData.Select(d => new {
                    x = new DateTimeOffset(d.Time).ToUnixTimeMilliseconds(),
                    y = d.Data
                }).ToArray()
            });
        }
        else if (selectedGroup != null)
        {
            foreach (KeyValuePair<string, List<DataObject>> kvp in groupData)
            {
                datasets.Add(new {
                    label = kvp.Key,
                    data = kvp.Value.Select(d => new {
                        x = new DateTimeOffset(d.Time).ToUnixTimeMilliseconds(),
                        y = d.Data
                    }).ToArray()
                });
            }
        }

        if (datasets.Count == 0)
        {
            showData = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            pendingDatasets = datasets;
            shouldRenderChart = true;
        }
        catch (JSException jsEx)
        {
            noDataMessage = "Chart rendering error: " + jsEx.Message;
            showData = false;
            Console.Error.WriteLine(jsEx);
            await InvokeAsync(StateHasChanged);
        }
    }

    private double? GetValue(SensorReading r)
    {
        if (selectedDataType == "Temperature") return r.Temperature;
        else if (selectedDataType == "Humidity") return r.Humidity;
        else if (selectedDataType == "Pressure") return r.Pressure;
        else if (selectedDataType == "Light") return r.Light;
        return null;
    }
}

<!-- chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns/dist/chartjs-adapter-date-fns.bundle.min.js"></script>
<script>
    const colors = [
        'rgba(59,125,217,0.8)',
        'rgba(255,99,132,0.8)',
        'rgba(75,192,192,0.8)',
        'rgba(255,205,86,0.8)',
        'rgba(153,102,255,0.8)',
        'rgba(255,159,64,0.8)',
        'rgba(201,203,207,0.8)',
        'rgba(54,162,235,0.8)',
        'rgba(255,0,0,0.8)',
        'rgba(0,255,0,0.8)'
    ];

    function getColor(label) {
        let hash = 0;
        for (let i = 0; i < label.length; i++) {
            hash = label.charCodeAt(i) + ((hash << 5) - hash);
        }
        return colors[Math.abs(hash) % colors.length];
    }

function renderLineChart(datasets) {
    const canvas = document.getElementById('analyticsChart');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');

    if (window._analyticsChart)
        window._analyticsChart.destroy();

    window._analyticsChart = new Chart(ctx, {
        type: 'line',
        data: {
            datasets: datasets.map((d, index) => ({
                label: d.label,
                data: d.data,
                fill: false,
                borderColor: colors[index % colors.length],
                tension: 0.1
            }))
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: {
                    type: 'time',
                    display: true
                },
                y: {
                    display: true
                }
            }
        }
    });
}
</script>