@page "/analytics"
@using Boardom.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Boardom.Services

@inject NavigationManager NavigationManager
@inject DeviceFunctions DeviceFunctions
@inject IJSRuntime JS

<PageTitle>BOARDOM - Analytics</PageTitle>

<div class="analytics-container">
    <div class="analytics-header">
        <h1 class="analytics-title">Analytics</h1>
        <p class="analytics-subtitle">View and analyze device data</p>
    </div>

    <!-- Device Selection Modal -->
    @if (!deviceSelected)
    {
        <div class="analytics-overlay">
            <div class="analytics-modal">
                <h2 class="modal-title">Select Device</h2>
                <p class="modal-subtitle">Choose a device to analyze</p>

                <div class="device-list">
                    @foreach (Device device in deviceList)
                    {
                       <div class="device-item" @onclick="() => SelectDevice(device)">
                            <span class="device-name">@device.Name</span>
                            @if (device.IsOnline)
                            {
                                <span class="device-status online">Online</span>
                            }
                            else
                            {
                                <span class="device-status offline">Offline</span>
                            }
                       </div> 
                    }
                </div>

                <div class="modal-actions">
                    <button class="btn btn-secondary" @onclick="CancelSelection">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (deviceSelected)
    {
        <div class="analytics-controls">
            <div class="selected-device-display" @onclick="ChangeDevice">
                <span class="selected-device-label">Device:</span>
                <span class="selected-device-name">@selectedDevice?.Name</span>
            </div>
            
            <div class="control-group">
                <label class="control-label">Data Type</label>
                <select class="form-control analytics-select" @bind="selectedDataType">
                    <option value="Temperature">Temperature</option>
                    <option value="Humidity">Humidity</option>
                    <option value="Light">Light Level</option>
                    <option value="Pressure">Pressure</option>
                </select>
            </div>

            <div class="control-group">
                <label class="control-label">Start Date</label>
                <input type="date" class="form-control analytics-date" @bind="startDate"/>
            </div>

            <div class="control-group">
                <label class="control-label">End Date</label>
                <input type="date" class="form-control analytics-date" @bind="endDate"/>
            </div>

            <div class="control-actions">
                <button class="btn btn-primary" @onclick="ShowData">View Data</button>
            </div>
        </div>

        @if (showData)
        {
            <div class="analytics-content">
                <canvas id="analyticsChart" class="w-100" style="max-height:500px; height:500px;" ></canvas>
            </div>
        }
        else
        {
        <div class="analytics-content">
            @if (!string.IsNullOrEmpty(noDataMessage))
            {
                <div class="no-data alert alert-warning">@noDataMessage</div>
            }
            else
            {
                <div class="chart-placeholder">
                    <div class="chart-icon">📊</div>
                    <p class="chart-text">Chart visualization will appear here</p>
                </div>
            }
        </div>
        }
    }
</div>

@code {

    List<Device> deviceList = new List<Device>();
    List<double?> dataList = new List<double?>();
    List<DateTime> timeList = new List<DateTime>();
    private Device? selectedDevice;
    private bool deviceSelected = false;
    private bool showData = false;
    private List<string> labels = new List<string>();
    private string noDataMessage = string.Empty;
    private string selectedDataType = "Temperature";
    private DateTime startDate = DateTime.Now;
    private DateTime endDate = DateTime.Now.AddDays(1);

    protected override async Task OnInitializedAsync()
    {
        deviceList = await DeviceFunctions.GetAllDevicesAsync();
    }

    private void CancelSelection()
    {
        NavigationManager.NavigateTo("/home");
    }

    private void SelectDevice(Device device)
    {
        deviceSelected = true;
        selectedDevice = device;
    }

    private void ChangeDevice()
    {
        deviceSelected = false;
        showData = false;
    }

    private async Task ShowData()
    {
        if (selectedDevice == null)
        {
            return;
        }

        dataList.Clear();
        timeList.Clear();
        labels.Clear();

        List<SensorReading>? allData = await DeviceFunctions.GetFilteredSensorDataAsync(
            selectedDevice.DeviceId,
            selectedDataType,
            startDate,
            endDate);

        if (allData == null || allData.Count == 0)
        {
            noDataMessage = "No data available for the selected device/date/type.";
            showData = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        allData = allData.OrderBy(r => r.DateAdded).ToList();

        foreach (SensorReading data in allData)
        {
            timeList.Add(data.DateAdded);
            labels.Add(data.DateAdded.ToLocalTime().ToString("MM/dd HH:mm"));
        }

        if (selectedDataType == "Temperature")
        {
            foreach (SensorReading data in allData)
            {
                dataList.Add(data.Temperature);
            }
        }
        else if (selectedDataType == "Humidity")
        {
            foreach (SensorReading data in allData)
            {
                dataList.Add(data.Humidity);
            }
        }
        else if (selectedDataType == "Pressure")
        {
            foreach (SensorReading data in allData)
            {
                dataList.Add(data.Pressure);
            }
        }
        else if (selectedDataType == "Light")
        {
            foreach (SensorReading data in allData)
            {
                dataList.Add(data.Light);
            }
        }

        noDataMessage = string.Empty;
        showData = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        await JS.InvokeVoidAsync("renderLineChart", labels.ToArray(), dataList.ToArray());
    }
}

<!-- chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    function renderLineChart(labels, values) {
        const canvas = document.getElementById('analyticsChart');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (window._analyticsChart) window._analyticsChart.destroy();
        window._analyticsChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{ label: "Data", data: values, fill: false, borderColor: 'rgba(59,125,217,0.8)', tension: 0.1 }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: { x: { display: true }, y: { display: true } }
            }
        });
    }
</script>