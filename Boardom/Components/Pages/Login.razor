@page "/"

@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation

<PageTitle>BOARDOM - Login</PageTitle>

<div class="login-page">
    <!-- Animated background elements -->

    <div class="login-container">
        <!-- Header Section -->
        <div class="login-header">
            <div class="logo-wrapper">
                <div class="logo-container">
                    <div class="logo-icon">◆</div>
                </div>
                <h1 class="logo-text">BOARDOM</h1>
            </div>
            <p class="login-subtitle">Smart Home Monitoring System</p>
        </div>

        <!-- Login Form Section -->
        <div class="login-form">
            <button type="button" class="btn-login" @onclick="HandleLogin">
                <span>Access Dashboard</span>
                <span class="btn-icon">→</span>
            </button>
        </div>

        <!-- Footer Section -->
        <div class="login-footer">
            <p class="login-text">
                New to BOARDOM? 
                <a href="#" class="sign-up-link">Create account</a>
            </p>
            <div class="footer-divider"></div>
            <p class="security-note">🔒 Secure login with encryption</p>
        </div>
    </div>

    <!-- Background decoration -->
    <div class="login-decoration"></div>
</div>

@code {
    private void HandleLogin()
    {
        Navigation.NavigateTo("/Account/Login", forceLoad: true);
    }
}