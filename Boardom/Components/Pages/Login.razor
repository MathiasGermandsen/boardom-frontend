@page "/"

<PageTitle>BOARDOM - Smart Home Monitoring</PageTitle>

<div class="landing-page">
  <!-- Background Elements -->
  <div class="bg-gradient"></div>
  <div class="bg-accent"></div>
  <div class="floating-shapes">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>
  </div>

  <!-- Navigation -->
  <nav class="landing-nav">
    <div class="nav-brand">
      <div class="nav-logo">◆</div>
      <span class="nav-title">BOARDOM</span>
    </div>
    <div class="nav-links">
      <a href="#features" class="nav-link">Features</a>
      <a href="#about" class="nav-link">About</a>
      <form method="post" action="/Account/LoginPost" data-enhance="false" class="nav-cta-form">
        <AntiforgeryToken />
        <button type="submit" class="nav-cta">Sign In</button>
      </form>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-icon">⚡</span>
        <span>Real-time Monitoring</span>
      </div>
      <h1 class="hero-title">
        Smart Home Monitoring
        <span class="hero-highlight">Made Simple</span>
      </h1>
      <p class="hero-subtitle">
        Monitor your household sensors in real-time. Track temperature, humidity,
        and light levels across all your devices from one unified dashboard.
      </p>
      <div class="hero-actions">
        <form method="post" action="/Account/LoginPost" data-enhance="false">
          <AntiforgeryToken />
          <button type="submit" class="btn-primary">
            <span>Access Dashboard</span>
            <span class="btn-icon">→</span>
          </button>
        </form>
        <a href="#features" class="btn-secondary">
          <span>Learn More</span>
        </a>
      </div>
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-number">5+</span>
          <span class="stat-label">Active Devices</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">24/7</span>
          <span class="stat-label">Monitoring</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-number">99.9%</span>
          <span class="stat-label">Uptime</span>
        </div>
      </div>
    </div>
    <div class="hero-visual">
      <div class="dashboard-preview">
        <div class="preview-header">
          <div class="preview-dots">
            <span></span><span></span><span></span>
          </div>
          <span class="preview-title">Dashboard</span>
        </div>
        <div class="preview-content">
          <div class="preview-card">
            <div class="preview-card-icon">🌡️</div>
            <div class="preview-card-info">
              <span class="preview-card-label">Temperature</span>
              <span class="preview-card-value">21.5°C</span>
            </div>
          </div>
          <div class="preview-card">
            <div class="preview-card-icon">💧</div>
            <div class="preview-card-info">
              <span class="preview-card-label">Humidity</span>
              <span class="preview-card-value">45%</span>
            </div>
          </div>
          <div class="preview-card">
            <div class="preview-card-icon">💡</div>
            <div class="preview-card-info">
              <span class="preview-card-label">Light Level</span>
              <span class="preview-card-value">320 lux</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="features-section">
    <div class="section-header">
      <span class="section-tag">Features</span>
      <h2 class="section-title">Everything you need to monitor your home</h2>
      <p class="section-subtitle">Powerful tools designed for seamless smart home management</p>
    </div>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon-wrapper">
          <span class="feature-icon">📊</span>
        </div>
        <h3 class="feature-title">Real-time Data</h3>
        <p class="feature-description">
          View live sensor readings instantly. Temperature, humidity, and light levels updated in real-time.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-icon-wrapper">
          <span class="feature-icon">🏠</span>
        </div>
        <h3 class="feature-title">Device Groups</h3>
        <p class="feature-description">
          Organize sensors by room or location. Keep your living room, bedroom, and kitchen devices separate.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-icon-wrapper">
          <span class="feature-icon">🔔</span>
        </div>
        <h3 class="feature-title">Smart Alerts</h3>
        <p class="feature-description">
          Get notified when readings exceed thresholds. Never miss an important change in your environment.
        </p>
      </div>
      <div class="feature-card">
        <div class="feature-icon-wrapper">
          <span class="feature-icon">🔐</span>
        </div>
        <h3 class="feature-title">Secure Access</h3>
        <p class="feature-description">
          Enterprise-grade security with encrypted connections. Your data stays private and protected.
        </p>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="about-section">
    <div class="about-content">
      <span class="section-tag">About</span>
      <h2 class="about-title">Built for modern smart homes</h2>
      <p class="about-text">
        BOARDOM brings together all your IoT sensors into one intuitive dashboard.
        Whether you're monitoring a single room or an entire building, our platform
        scales to meet your needs while keeping things simple.
      </p>
      <div class="about-features">
        <div class="about-feature">
          <span class="about-check">✓</span>
          <span>Easy setup in minutes</span>
        </div>
        <div class="about-feature">
          <span class="about-check">✓</span>
          <span>No technical expertise required</span>
        </div>
        <div class="about-feature">
          <span class="about-check">✓</span>
          <span>Works with popular sensors</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="landing-footer">
    <div class="footer-content">
      <div class="footer-brand">
        <div class="footer-logo">
          <span class="footer-logo-icon">◆</span>
          <span class="footer-logo-text">BOARDOM</span>
        </div>
        <p class="footer-tagline">Smart Home Monitoring System</p>
      </div>
      <div class="footer-links">
        <a href="#features" class="footer-link">Features</a>
        <a href="#about" class="footer-link">About</a>
        <a href="#" class="footer-link">Privacy</a>
        <a href="#" class="footer-link">Terms</a>
      </div>
      <div class="footer-cta">
        <p class="footer-cta-text">Ready to get started?</p>
        <form method="post" action="/Account/LoginPost" data-enhance="false">
          <AntiforgeryToken />
          <button type="submit" class="btn-footer">
            Access Dashboard →
          </button>
        </form>
      </div>
    </div>
    <div class="footer-bottom">
      <p class="footer-copyright">© 2026 BOARDOM. All rights reserved.</p>
      <p class="footer-security">🔒 Secured with enterprise-grade encryption</p>
    </div>
  </footer>
</div>