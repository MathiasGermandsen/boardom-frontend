@page "/"

<PageTitle>BOARDOM - Login</PageTitle>

<div class="login-page">

    <div class="login-container">

        <div class="login-header">
            <div class="logo-wrapper">
                <div class="logo-container">
                    <div class="logo-icon">◆</div>
                </div>
                <h1 class="logo-text">BOARDOM</h1>
            </div>
            <p class="login-subtitle">Smart Home Monitoring System</p>
        </div>

        <div class="login-form">
            <form method="post" action="/Account/LoginPost" data-enhance="false" style="width: 100%; display: flex; justify-content: center;">
                <AntiforgeryToken />
                <button type="submit" class="btn-login">
                    <span>Access Dashboard</span>
                    <span class="btn-icon">→</span>
                </button>
            </form>
        </div>

        <div class="login-footer">
            <p class="login-text">
                New to BOARDOM? 
                <a href="#" class="sign-up-link">Create account</a>
            </p>
            <div class="footer-divider"></div>
            <p class="security-note">🔒 Secure login with encryption</p>
        </div>
    </div>

    <div class="login-decoration"></div>
</div>