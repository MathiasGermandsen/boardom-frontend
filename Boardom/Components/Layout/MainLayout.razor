@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager
@inject Boardom.Services.KioskModeService KioskMode

<CascadingValue Name="IsKioskMode" Value="KioskMode.IsKioskMode">
@{
    var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?')[0].TrimEnd('/');
    var isLandingPage = !KioskMode.IsKioskMode && (
                        NavigationManager.Uri == NavigationManager.BaseUri ||
                        relativePath == "" ||
                        relativePath == "howto");
}

@if (KioskMode.IsKioskMode)
{
    if (relativePath != "power")
    {
        NavigationManager.NavigateTo("/power", replace: true);
    }
    <div class="kiosk-layout">
        @Body
    </div>
}
else if (isLandingPage)
{
    <div class="landing-layout">
        @Body
    </div>
}
else
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
}
</CascadingValue>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override void OnInitialized()
    {
        KioskMode.OnChange += OnKioskModeChanged;
    }

    private void OnKioskModeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        KioskMode.OnChange -= OnKioskModeChanged;
    }
}
