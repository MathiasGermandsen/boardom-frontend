@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<MainLayout> _logger


@{
    var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?')[0].TrimEnd('/');
    var isLandingPage = NavigationManager.Uri == NavigationManager.BaseUri ||
                        relativePath == "" ||
                        relativePath == "howto";
}

@if (isLandingPage)
{
    <div class="landing-layout">
        @Body
    </div>
}
else
{
    <div class="page">
        <div class="sidebar">
            <NavMenu />
        </div>

        <main>
            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool isSmallScreen = false;
    private Task<AuthenticationState>? authState;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationState { get; set; } = null!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckAndEnforceScreenSize();
            await JS.InvokeVoidAsync("setupResizeListener", DotNetObjectReference.Create(this));
        }
    }

    private async Task CheckAndEnforceScreenSize()
    {
        AuthenticationState? authState = await AuthenticationState;
        bool isAuthenticated = authState.User?.Identity?.IsAuthenticated ?? false;

        string? relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?')[0].TrimEnd('/');

        //900p and smaller screens are only allowed to see power pi and login.
        int windowHeight = await JS.InvokeAsync<int>("getWindowHeight");
        
        _logger.LogInformation($"Device Window Height: {windowHeight}");
            
        if (windowHeight <= 900)
        {
            //if user is NOT LOGGED IN: only allow home and login
            if(!isAuthenticated)
            {
                bool isAllowedPage = relativePath == "" || relativePath == "login" || relativePath == "home";
                if(!isAllowedPage)
                {
                    NavigationManager.NavigateTo("/home");
                }
            }
            //If user IS logged in: force load to powerpi after login
            else 
            {
                if (relativePath !="power")
                {
                    NavigationManager.NavigateTo("/power");
                }
            }
        }
    }

    [JSInvokable]
    public async Task onWindowResize()
    {
        await CheckAndEnforceScreenSize();
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("removeResizeListener");
        }
        catch { }
    }
}