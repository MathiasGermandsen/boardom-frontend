@inject Boardom.Services.KioskModeService KioskMode
@inject NavigationManager NavigationManager

<div class="top-row navbar navbar-dark navbar-boardom">
    <div class="navbar-container">
        <a class="navbar-brand" href="home">
            <span class="brand-icon">◆</span>
            <span class="brand-text">BOARDOM</span>
        </a>
        <label class="navbar-toggler" for="nav-toggle" title="Navigation menu"></label>
    </div>
</div>

<input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox" />

<div class="nav-scrollable" onclick="document.querySelector('#nav-toggle').checked = false">
    <nav class="flex-column nav-menu">
        <div class="nav-section">
            <div class="nav-section-title">Main</div>
            <div class="nav-item">
                <NavLink class="nav-link" href="home" Match="NavLinkMatch.All">
                    <span class="nav-icon">■</span>
                    <span class="nav-text">Dashboard</span>
                </NavLink>
            </div>
        </div>
        <div class="nav-section">
            <div class="nav-section-title">System</div>
            <div class="nav-item">
                <NavLink class="nav-link" href="devices">
                    <span class="nav-icon">◇</span>
                    <span class="nav-text">Devices</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="analytics">
                    <span class="nav-icon">●</span>
                    <span class="nav-text">Analytics</span>
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="power">
                    <span class="nav-icon">⚡</span>
                    <span class="nav-text">Power Pi</span>
                </NavLink>
            </div>
        </div>
        <div class="nav-section">
            <div class="nav-section-title">Help</div>
            <div class="nav-item">
                <a class="nav-link" href="/howto">
                    <span class="nav-icon">📖</span>
                    <span class="nav-text">How To Guide</span>
                </a>
            </div>
            <div class="nav-item">
                <button type="button" class="nav-link tour-btn" onclick="window.boardomTour.startTour()">
                    <span class="nav-icon">🗺️</span>
                    <span class="nav-text">Start Tour</span>
                </button>
            </div>
        </div>
        <div class="nav-section">
            <div class="nav-section-title">Display</div>
            <div class="nav-item">
                <button type="button" class="nav-link kiosk-btn" @onclick="EnterKioskMode">
                    <span class="nav-icon">🖥️</span>
                    <span class="nav-text">Kiosk Mode</span>
                </button>
            </div>
        </div>
        <div class="nav-section">
            <div class="nav-section-title">Account</div>
            <div class="nav-item">
                <form method="post" action="/Account/Logout" style="display: contents;">
                    <AntiforgeryToken />
                    <button type="submit" class="nav-link logout-btn">
                        <span class="nav-icon">🚪</span>
                        <span class="nav-text">Logout</span>
                    </button>
                </form>
            </div>
        </div>
    </nav>
</div>

@code {
    private void EnterKioskMode()
    {
        KioskMode.EnableKioskMode();
        NavigationManager.NavigateTo("/power", replace: true);
    }
}
